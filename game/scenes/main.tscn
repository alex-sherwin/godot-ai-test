[gd_scene load_steps=3 format=3]

; run/main_scene. The export preset and CI both key off this path, so it stays
; here (README "the aero pipeline seam").
;
; Deliberately thin: FlightApp owns the simulation loop and builds the disc,
; cameras, trails, vector overlay, wind and HUD in code, because all of them are
; procedural and none of them are worth hand-maintaining as scene data. The
; range is a real scene instance because its lighting and environment ARE worth
; being able to open and look at.

[ext_resource type="Script" path="res://scripts/app/flight_app.gd" id="1_app"]
[ext_resource type="PackedScene" path="res://scenes/world/range.tscn" id="2_range"]

[node name="Main" type="Node3D"]
script = ExtResource("1_app")

[node name="Range" parent="." instance=ExtResource("2_range")]

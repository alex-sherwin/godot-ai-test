[gd_scene load_steps=2 format=3]

; The puzzle-mode screenshot harness. Deliberately thin, exactly like
; `portal_probe.tscn`: the script instances the REAL `puzzle_mode.tscn` and
; drives its public API, so what it photographs is the shipped scene and not a
; second copy of it.
;
;     xvfb-run -a godot --path game --rendering-driver opengl3 \
;         res://scenes/portal/puzzle_probe.tscn -- --capture=/tmp/shots
;
; Not reachable from `boot.tscn`, and nothing in either mode references it.

[ext_resource type="Script" path="res://scripts/portal/puzzle_probe.gd" id="1_probe"]

[node name="PuzzleProbe" type="Node"]
script = ExtResource("1_probe")
